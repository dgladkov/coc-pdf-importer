    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "es-arraybuffer-base64": "^1.1.2",
    "math.sumprecise": "^1.0.1",
    "pdfjs-dist": "^6.2.108"
